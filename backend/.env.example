# --- App ---
APP_NAME="Tax Intelligence System API"
ENVIRONMENT=development
DEBUG=false

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://tis_user:tis_password@localhost:5432/tax_intelligence_db

# --- Auth ---
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- PBJT ---
PBJT_TAX_RATE=0.10
